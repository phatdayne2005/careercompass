# Mẫu biến môi trường cho docker-compose.
# Copy thành .env rồi điền giá trị thật: cp .env.example .env

# ===== Database =====
DB_USERNAME=root
DB_PASSWORD=doi-mat-khau-manh-o-day
# Port host cho MySQL Workbench. VPS: 3306. Máy dev đã có MySQL sẵn: dùng 3307.
DB_PORT=3306

# ===== App =====
APP_PORT=8080
# Dùng để build link trong email reset password + redirect OAuth2.
BASE_URL=http://your-vps-ip:8080

# ===== Google OAuth2 (Google Cloud Console) =====
GOOGLE_CLIENT_ID=mock
GOOGLE_CLIENT_SECRET=mock

# ===== Gmail SMTP (App Password 16 ký tự) =====
MAIL_USERNAME=mock
MAIL_PASSWORD=mock

# ===== Google Gemini API =====
GEMINI_API_KEY=mock

# ===== Tài khoản seed lần đầu chạy =====
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=doi-mat-khau
STUDENT_EMAIL=student@gmail.com
STUDENT_PASSWORD=doi-mat-khau
COUNSELOR_EMAIL=counselor@gmail.com
COUNSELOR_PASSWORD=doi-mat-khau
